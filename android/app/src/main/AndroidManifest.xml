<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.questapp">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" />
    <!-- CONTROLLERS AND HANDS. Without these the Quest refuses to launch the
         app while no controller is active: a "Switch to Controllers" system
         dialog blocks entry until one is picked up. That stopped the
         unattended benchmark (bench.py) with the headset lying on a desk
         (2026-09-27). required="false": hands are supported and controllers
         still work; the app's XR_EXT_hand_tracking path now receives tracked
         hands when the controllers are put down. -->
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />

    <application
        android:label="QuestApp"
        android:hasCode="false">

        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest|quest2|questpro|quest3" />

        <!-- NPU GATE 0, step 3. The FastRPC client to the Hexagon DSP is on the
             device and listed in /vendor/etc/public.libraries.txt, and dlopen
             still refuses it by name AND by absolute path: "not accessible for
             the namespace clns-6". This is the one mechanism Android offers an
             app to ask for a non-NDK native library by name (API 31+, and this
             app targets 35). required=false so a refusal is a log line rather
             than a failed install. See quest_app/src/npu_probe.rs. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">

            <meta-data
                android:name="android.app.lib_name"
                android:value="quest_app" />

            <meta-data
                android:name="com.oculus.vr.focusaware"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>